{
  "app": {
    "name": "DataPipeline",
    "version": "2.1.0",
    "settings": {
      "logging": {
        "level": "debug",
        "output": "stdout",
        "rotation": {
          "max_size_mb": 100,
          "max_files": 10
        }
      },
      "database": {
        "host": "db.internal.example.com",
        "port": 5432,
        "name": "pipeline_db",
        "pool": {
          "min": 2,
          "max": 20
        },
        "ssl": {
          "enabled": true,
          "mode": "verify-full"
        }
      },
      "cache": {
        "type": "redis",
        "ttl_seconds": 3600
      }
    },
    "endpoints": [
      {
        "path": "/api/v1/ingest",
        "method": "POST",
        "rate_limit": 1000
      },
      {
        "path": "/api/v1/query",
        "method": "GET",
        "rate_limit": 5000
      }
    ]
  }
}
